# ══════════════════════════════════════════════════════
#  Clinique Connectée — .gitignore
# ══════════════════════════════════════════════════════

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl
.venv/
venv/
env/
ENV/
pip-log.txt

# Tests / Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Variables d'environnement (NE JAMAIS COMMIT)
.env
.env.local
.env.production
*.env

# Docker
docker-compose.override.yml

# Logs
*.log
logs/
mosquitto/log/

# Données générées
donnees_enr/
__pycache__/

# Certificats (sensibles)
certs/
*.key
*.crt
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node modules (react dashboard)
node_modules/
.npm/

# Build React
dist/
build/

# Redis data
redis/data/
dump.rdb
appendonly.aof

# MongoDB data
mongodb/data/

# Cython debug symbols
cython_debug/

.abstra/

tempCodeRunnerFile.py

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml
=======


# ── Secrets / certificats ──────────────────────────────
certs/*.key
certs/*.pem
*.env
.env
.env.*
!.env.example

# ── Python (api/, simulateur/) ─────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ── Node / React dashboard ──────────────────────────────
node_modules/
react-dashboard/node_modules/
react-dashboard/dist/
react-dashboard/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker / volumes locaux ─────────────────────────────
mosquitto/log/*
!mosquitto/log/.gitkeep
mosquitto/data/*
!mosquitto/data/.gitkeep

# ── Node-RED (contient des credentials chiffrés) ───────
node-red/node_modules/
node-red/.config.json
node-red/.config.nodes.json
node-red/*_cred.json

# ── Redis dumps ──────────────────────────────────────────
*.rdb
*.aof
appendonlydir/

# ── Logs divers ──────────────────────────────────────────
*.log
logs/

# ── IDE / OS ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Build artefacts divers ───────────────────────────────
*.pio/
.pio/
build/
dist/
