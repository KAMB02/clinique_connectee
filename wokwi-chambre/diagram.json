{
  "version": 1,
  "author": "Clinique Connectée — UFHB IoT 2025-2026",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -80,
      "left": -180,
      "attrs": { "label": "T° / Humidité Chambre" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 120,
      "left": -180,
      "attrs": {
        "color": "red",
        "label": "Appel Patient"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_mouvement",
      "top": 120,
      "left": 220,
      "attrs": {
        "color": "yellow",
        "label": "Mouvement"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 148,
      "left": 160,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alerte",
      "top": 60,
      "left": 220,
      "attrs": {
        "color": "red",
        "label": "Alerte Active"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 88,
      "left": 160,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX",   "$serialMonitor:RX", "", [] ],
    [ "esp:RX",   "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3",    "red",   [ "v0" ] ],
    [ "dht1:SDA", "esp:4",      "green", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1",  "black", [ "v0" ] ],

    [ "btn1:1.l", "esp:GND.2",  "black", [ "v0" ] ],
    [ "btn1:2.r", "esp:0",      "blue",  [ "v0" ] ],

    [ "esp:2",    "r1:1",       "yellow", [ "v0" ] ],
    [ "r1:2",     "led_mouvement:A", "yellow", [ "v0" ] ],
    [ "led_mouvement:C", "esp:GND.3", "black", [ "v0" ] ],

    [ "esp:15",   "r2:1",       "orange", [ "v0" ] ],
    [ "r2:2",     "led_alerte:A", "orange", [ "v0" ] ],
    [ "led_alerte:C", "esp:GND.4", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}